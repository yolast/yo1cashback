# ============================================================
# YO1Cashback Backend Environment
# ============================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# MongoDB Atlas (create a NEW dedicated cluster/db for YO1Cashback)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/yo1cashback?retryWrites=true&w=majority

# DNS resolvers for SRV/TXT lookups (mongodb+srv requires SRV).
# Set to public resolvers if your local DNS/VPN refuses SRV queries (querySrv ECONNREFUSED).
DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Firebase Admin (create a NEW Firebase project for YO1Cashback)
FIREBASE_PROJECT_ID=yo1cashback
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@yo1cashback.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin bootstrap (email/password seeded as Super Admin by `npm run seed`)
ADMIN_EMAIL=admin@yo1cashback.com
ADMIN_PASSWORD=ChangeMe123!

# Cashback & referral defaults
MIN_WITHDRAWAL=10
MAX_WITHDRAWAL=0
REFERRAL_BONUS_RATE=10
CASHBACK_CONFIRM_DAYS=30

# Optional: affiliate postback security key
POSTBACK_SECRET=change-me-too

# ============================================================
# YOlast.com legacy database — restrict login to EXISTING users only
# (no new registrations). Login is rejected if the user is not found here.
# ============================================================
# LEGACY_DB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<yolast-db>
# LEGACY_DB_NAME=yolast
# LEGACY_USERS_COLLECTION=users
# LEGACY_USER_MATCH_FIELD=phone
